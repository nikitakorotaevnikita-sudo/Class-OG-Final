# OpenAI / LLM
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_SERVER=

# Directum RX API (если прототип интегрируется с RX)
# Базовый URL системы Directum RX БЕЗ trailing slash
# Пример: https://your-instance.directum.ru
DIRECTUM_BASE_URL=
DIRECTUM_TOKEN=YOUR_TOKEN

# Бэкофис Basic Auth (защита /backoffice и /api/metrics)
BACKOFFICE_USER=admin
BACKOFFICE_PASSWORD=changeme
