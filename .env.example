# Скопируй этот файл в .env и заполни значения
# cp .env.example .env

# --- Groq API (обязательно) ---
# Бесплатный ключ: https://console.groq.com/keys
GROQ_API_KEY=gsk_PASTE_YOUR_KEY_HERE

# --- Модель LLM ---
GROQ_MODEL=llama-3.3-70b-versatile

# --- Параметры поиска ---
TOP_K_CANDIDATES=10
MIN_CONFIDENCE=0.65

# --- Дообучение ---
# Количество верифицированных записей для запуска fine-tuning
FINETUNE_THRESHOLD=50

# --- API сервер ---
API_HOST=0.0.0.0
API_PORT=8000

# --- После дообучения ---
# Указать путь к дообученной модели:
# EMBEDDING_MODEL=models/e5-finetuned-v1
