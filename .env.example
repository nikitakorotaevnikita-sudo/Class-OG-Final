# Скопируй этот файл в .env и заполни значения
# cp .env.example .env

# --- LLM провайдер ---
# groq (рекомендуется) | gemini (20 req/day) | ollama (локально)
LLM_PROVIDER=groq

# --- Groq API (обязательно при LLM_PROVIDER=groq) ---
GROQ_API_KEY=gsk_PASTE_YOUR_KEY_HERE

# --- Google Gemini API (обязательно при LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=AIzaPASTE_YOUR_KEY_HERE

# --- Ollama API (обязательно при LLM_PROVIDER=ollama) ---
# скачать модель: ollama pull qwen2.5-14b
# запустить: ollama serve
OLLAMA_MODEL=qwen2.5-14b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Модель LLM ---
GROQ_MODEL=llama-3.3-70b-versatile

# --- Параметры поиска ---
TOP_K_CANDIDATES=10
MIN_CONFIDENCE=0.65

# --- Дообучение ---
# Количество верифицированных записей для запуска fine-tuning
FINETUNE_THRESHOLD=50

# --- API сервер ---
API_HOST=0.0.0.0
API_PORT=8000

# --- После дообучения ---
# Указать путь к дообученной модели:
# EMBEDDING_MODEL=models/e5-finetuned-v1
