# Скопируй этот файл в .env и заполни значения
# cp .env.example .env

# --- LLM провайдер ---
# groq (рекомендуется) | gemini (20 req/day) | ollama (локально)
LLM_PROVIDER=groq

# Сколько ждать ответа LLM. Новые сборки модели отвечают дольше двух минут.
LLM_TIMEOUT_SEC=300

# Фоновая обработка: RX получает идентификатор задачи сразу и опрашивает статус
JOB_TTL_HOURS=24        # сколько хранить результаты выполненных задач
JOB_MAX_QUEUED=100      # предел очереди; сверх него приём отвечает 429

# --- Groq API (обязательно при LLM_PROVIDER=groq) ---
GROQ_API_KEY=gsk_PASTE_YOUR_KEY_HERE

# --- Google Gemini API (обязательно при LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=AIzaPASTE_YOUR_KEY_HERE

# --- Ario, корпоративный LLM Directum360 (основной провайдер: LLM_PROVIDER=ario) ---
# Доступен только из корпоративной сети или через VPN
ARIO_API_KEY=PASTE_ARIO_KEY_HERE
ARIO_BASE_URL=https://gpt.ario.directum360.ru/v1
ARIO_MODEL=Qwen/Qwen3.6-35B-A3B

# --- Ollama API (обязательно при LLM_PROVIDER=ollama) ---
# скачать модель: ollama pull qwen2.5-14b
# запустить: ollama serve
OLLAMA_MODEL=qwen2.5-14b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Модель LLM ---
GROQ_MODEL=llama-3.3-70b-versatile

# --- Параметры поиска ---
TOP_K_CANDIDATES=50
MIN_CONFIDENCE=0.65
# Эвристический реранкер (merge dense+lexical + branch/parent бусты).
# false = LLM получает чистый dense top-K. По замерам на ii25_test реранкер
# выталкивает золотой код из top-10 (recall@10 41.1% -> 10.7%), поэтому off.
ENABLE_HEURISTIC_RERANKER=false

# --- Дообучение ---
# Количество верифицированных записей для запуска fine-tuning
FINETUNE_THRESHOLD=50

# --- API сервер ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Бэк-офис (Basic Auth) ---
BACKOFFICE_USER=admin
BACKOFFICE_PASSWORD=CHANGE_ME

# --- После дообучения ---
# Указать путь к дообученной модели:
# EMBEDDING_MODEL=models/e5-finetuned-v1

# Интеграция с Directum RX (OData integration service)
RX_ODATA_URL=http://172.16.96.98/integration/odata
RX_USER=Administrator
RX_PASSWORD=PASTE_RX_PASSWORD_HERE

# --- Активная векторная база ---
# Боевая — vector_db_adapted_v3 (лежит в репозитории, пересобирать не нужно)
VECTOR_DB_DIR=data/vector_db_adapted_v3

# Повторный проход по ПОЛНОМУ классификатору при промахе ретривера.
# Порог МОДЕЛЬ-СПЕЦИФИЧЕН: у vector_db_adapted_v3 similarity топ-1 ~0.15-0.35.
# При завышенном значении фоллбэк срабатывает на каждом обращении.
ENABLE_FULL_CLASSIFIER_FALLBACK=false
FULL_FALLBACK_SIM_THRESHOLD=0.15

# Детекция повторного обращения -> доп. код 0001.0002.0027.0125
ENABLE_REPEAT_DETECTION=false

# Детекция просьбы прекратить рассмотрение -> доп. код 0001.0002.0027.0131
ENABLE_WITHDRAWAL_DETECTION=false

# --- Машинно-зависимые пути и порты (правятся при переносе на другую машину) ---
# Кэш моделей Hugging Face на хосте. Если не задан — контейнер скачает модель сам.
HF_CACHE_DIR=

# Адрес Hugging Face. По умолчанию библиотека идёт на https://huggingface.co.
# Задавать только если прямой доступ закрыт и есть рабочее зеркало:
# HF_ENDPOINT=https://hf-mirror.com
# Порт, на котором сервис виден снаружи (адрес для RX)
HOST_PORT=8010
