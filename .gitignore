# Секреты — любые .env кроме шаблона (.env.minilm и прочие варианты стендов)
.env
.env.*
!.env.example

# Виртуальное окружение Python
venv/
.venv/

# Векторные базы — бинарники, пересобираются скриптами. Закрыты все, кроме
# боевой vector_db_adapted_v3: она коммитится намеренно, её копирует Dockerfile.
data/vector_db_*/
!data/vector_db_adapted_v3/
data/vector_db/

# PTO-эксперименты (adapter_v2 / SVC — не в проде)
data/pto_*
data/test_sample_pto.jsonl
data/retrieval_v3_report.json
data/retrieval_v3_fixed_report.json

# Временные файлы экспериментов
tmp_*
temp_*.cmd

# Кэшированные query embeddings (пересобираются скриптом encode_queries.py).
# Шаблон со * в конце — чтобы ловить и варианты с тегом модели (*_minilm и т.п.)
data/ii25_*_query_embs*.npy
data/ii25_*_query_meta*.json

# Логи прогонов на альтернативных моделях (боевые логи — отслеживаются)
data/appeals_log_*.jsonl
data/request_log_*.jsonl

# Дообученные модели — большие файлы исключены, лёгкие артефакты коммитим
models/*
!models/.gitkeep
!models/adapter_v1.npz
!models/adapter_v1.json
!models/ltr_v1.json
!models/ltr_gbm_v1.joblib

# Старая векторная база ChromaDB
data/chroma_db/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# dev-only 3.13 env (not the project 3.11 venv)
venv313/

# Eval results (raw output, generated per-run)
eval_results/*
!eval_results/.gitkeep

# Локальный бандл модели эмбеддингов (1.3 ГБ) — качается/распаковывается на стенде
offline_bundle/

# Node-зависимости Playwright
node_modules/

# Артефакты прогонов Playwright и покрытия
test-results/
playwright-report/
.coverage
.hypothesis/

# Логи запуска сервиса (uvicorn пишет сюда stdout/stderr)
logs/

# Фоновые задачи классификации: в результатах ФИО, почта и суть обращения — ПДн
data/jobs/*
!data/jobs/.gitkeep
