# Auto detect text files and perform LF normalization
* text=auto

# Shell-скрипты и unit-файлы systemd только с LF: при checkout на Windows
# core.autocrlf=true подставил бы CRLF, и на Linux запуск падает с
# "bad interpreter: No such file or directory".
*.sh text eol=lf
*.service text eol=lf
*.service.template text eol=lf

# Пакетные файлы Windows только с CRLF: в репозитории хранятся с LF, при checkout
# всегда получают CRLF — независимо от core.autocrlf у клона и в zip-архиве
# GitHub. cmd.exe с LF-окончаниями ошибается в метках и goto.
*.cmd text eol=crlf
*.bat text eol=crlf
